[submodule "modules/cmsis_core"]
	path = modules/cmsis_core
	url = https://github.com/STMicroelectronics/cmsis_core.git
[submodule "modules/cmsis_device_h5"]
	path = modules/cmsis_device_h5
	url = https://github.com/STMicroelectronics/cmsis_device_h5.git
[submodule "modules/stm32h5xx_hal_driver"]
	path = modules/stm32h5xx_hal_driver
	url = https://github.com/STMicroelectronics/stm32h5xx_hal_driver.git
[submodule "modules/mcuboot"]
	path = modules/mcuboot
	url = https://github.com/mcu-tools/mcuboot.git
[submodule "modules/mbedtls"]
	path = modules/mbedtls
	url = https://github.com/Mbed-TLS/mbedtls.git
