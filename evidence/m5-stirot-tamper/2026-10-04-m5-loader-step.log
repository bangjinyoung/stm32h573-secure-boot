gdb step-debug of LOADER_Run (user-approved). gdbserver: ST-LINK_gdbserver -p 61234 -d -g -e -m 1 (attach, no reset). Script below, then gdb output.
----- step.gdb -----
set pagination off
set confirm off
set breakpoint auto-hw on
file /home/bjy/workspaces/stm32h573-secure-boot/build/stirot_appli/appli.elf
target extended-remote :61234

define common
  printf "=== %s ===\n", $arg0
  x/i $pc
  info registers pc xpsr msp_s msp_ns psp_ns msplim_ns psplim_ns control_ns primask_ns basepri_ns faultmask_ns
  printf "CFSR HFSR DFSR: "
  x/3wx 0xE000ED28
  printf "SFSR: "
  x/wx 0xE000EDE4
  printf "HDPLSR: "
  x/wx 0x54000414
  printf "DHCSR: "
  x/wx 0xE000EDF0
end

define gtzc
  printf "TZSC1 SECCFGR1-3: "
  x/3wx 0x50032410
  printf "TZSC1 PRIVCFGR1-3: "
  x/3wx 0x50032420
  printf "MPCBB1 CR: "
  x/wx 0x50032C00
  printf "MPCBB1 SECCFGR[0..31]:\n"
  x/32wx 0x50032D00
  printf "MPCBB1 PRIVCFGR[0..31]:\n"
  x/32wx 0x50032E00
  printf "MPCBB3 CR: "
  x/wx 0x50033400
  printf "MPCBB3 SECCFGR[0..31]:\n"
  x/32wx 0x50033500
  printf "MPCBB3 PRIVCFGR[0..31]:\n"
  x/32wx 0x50033600
end

define gpio
  printf "GPIOA-D SECCFGR: "
  x/wx 0x52020030
  x/wx 0x52020430
  x/wx 0x52020830
  x/wx 0x52020C30
end

define nvicsc
  printf "AIRCR (S view 0xE000ED0C, NS view 0xE002ED0C): "
  x/wx 0xE000ED0C
  x/wx 0xE002ED0C
  printf "ITNS[0..3]: "
  x/4wx 0xE000E380
  printf "VTOR_S VTOR_NS: "
  x/wx 0xE000ED08
  x/wx 0xE002ED08
  printf "MPU_CTRL S: "
  x/wx 0xE000ED94
  printf "NSACR FPCCR: "
  x/wx 0xE000ED8C
  x/wx 0xE000EF34
end

define saudump
  printf "SAU_CTRL SAU_TYPE SAU_RNR: "
  x/3wx 0xE000EDD0
  set $rnr0 = *(unsigned int *)0xE000EDD8
  set $i = 0
  while $i < 8
    set *(unsigned int *)0xE000EDD8 = $i
    printf "SAU region %d RBAR 0x%08x RLAR 0x%08x\n", $i, *(unsigned int *)0xE000EDDC, *(unsigned int *)0xE000EDE0
    set $i = $i + 1
  end
  set *(unsigned int *)0xE000EDD8 = $rnr0
  printf "SAU_RNR restored: "
  x/wx 0xE000EDD8
end

define stepto
  hbreak *$arg0
  continue
  delete $bpnum
  if $pc != $arg0
    printf "UNEXPECTED STOP at 0x%08x (expected %s), aborting with core halted\n", $pc, "$arg0"
    common "unexpected stop"
    disconnect
    quit
  end
end

hbreak HardFault_Handler
hbreak MemManage_Handler
hbreak *0x0c000c58
printf "ARMED: waiting for menu 1 (LOADER_Run 0x0c000c58)\n"
continue
delete 3
common "LOADER_Run entry"

stepto 0x0c000c72
common "before gtzc_loader_cfg"
gtzc
