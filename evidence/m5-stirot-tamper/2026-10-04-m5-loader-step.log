stepto 0x0c000c98
common "after HDPL increment store"
stepto 0x0c000ca2
common "after msr MSP_NS"
info registers r1 r3
stepto 0x0c000ca6
common "after VTOR_NS store"
nvicsc
stepto 0x0c000cc4
common "BXNS handoff snapshot"
info registers
nvicsc
gpio
gtzc
saudump
printf "Bootloader vector 0x0BF97000: "
x/2wx 0x0BF97000
hbreak *0x0BF9F0F0
printf "ARMED: bootloader reset vector 0x0BF9F0F0, continuing from BXNS\n"
continue
common "after continue from BXNS"
info registers
printf "DONE: leaving core halted (disconnect)\n"
disconnect
